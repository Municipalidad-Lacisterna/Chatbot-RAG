# =============================================
# Configuración del Chatbot RAG - Alcaldía
# =============================================

# Dominio para el certificado HTTPS. Deja "localhost" para pruebas locales,
# o pon tu dominio (ej. chatbot.lacisterna.cl) para producción.
DOMAIN_NAME=localhost

# --- Proveedor y Modelo LLM ---
# Usamos el modelo local con Soberanía de Datos total.
LLM_PROVIDER=ollama
# Modelo local que se descargará (recomendado: qwen2.5:7b para texto o qwen2.5-vl:7b para visión)
LLM_MODEL=qwen2.5:7b

# Parámetros Ollama
OLLAMA_HOST=http://ollama:11434
OLLAMA_MODEL=qwen2.5:7b
# Evita que el modelo se descargue de memoria rápido
SANTI_OLLAMA_KEEP_ALIVE=10m

# --- Llaves Externas (opcionales) ---
# Supabase (para logging, base de datos externa, etc.)
SUPABASE_URL=
SUPABASE_KEY=
# Google API (si se cambiara el LLM_PROVIDER a google temporalmente)
GOOGLE_API_KEY=

# --- RAG y Memoria ---
TOP_K=2
CHUNK_SIZE=2400
CHUNK_OVERLAP=240
MEMORY_LAST_TURNS=3
HISTORY_MAX_AGE=86400

# --- Panel del Agente Humano ---
AGENTE_PANEL_CLAVE=SuperSecretoCisterna2026
CONTACTO_TELEFONO="2 2345 6000"
CONTACTO_EMAIL="atencion@lacisterna.cl"
AGENTE_HORARIO_TEXTO="Lunes a Viernes, de 9:00 a 17:00 hrs."
AGENTE_HORA_INICIO="09:00"
AGENTE_HORA_FIN="17:00"

# --- Ingesta desde Drive ---
# Carpeta pública de la municipalidad (extrae la ID de la URL)
DRIVE_URL=16paTbHeCuQw9YWH-ldniMJbxzuQvjBLD
