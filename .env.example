# =============================================
# Configuración del Chatbot RAG - Alcaldía
# =============================================
# Copia este archivo a `.env` y rellena tus datos.

# --- Proveedor del modelo LLM ---
# "google" = Gemini (free tier, costo $0, para desarrollo sin GPU).
# "ollama" = LLM local (Qwen2.5-VL, para el servidor de producción con GPU;
#             soberanía total de datos, la información nunca sale del servidor).
LLM_PROVIDER=google

# --- Solo si LLM_PROVIDER=google: llave de la API de Google (Gemini) ---
# Obligatoria para el modo google.
GOOGLE_API_KEY=tu_api_key_de_gemini

# Modelo LLM (Gemini free tier por defecto, costo $0).
# En desarrollo el más estable y barato verificado es gemini-3.1-flash-lite.
LLM_MODEL=gemini-3.1-flash-lite

# --- Solo si LLM_PROVIDER=ollama: configuración del LLM local ---
# Host del servidor Ollama (local en el servidor de producción).
# OLLAMA_HOST=http://localhost:11434
# Modelo multimodal local (Qwen2.5-VL ve texto e imágenes). Requiere GPU.
# OLLAMA_MODEL=qwen2.5-vl:7b

# --- Retrieval (top-k = cuántos fragmentos recuperar por pregunta) ---
# Un valor bajo (2) ahorra tokens en el prompt.
TOP_K=2

# --- Chunking (tamaño de fragmento, en caracteres) ---
# ~2400 caracteres ≈ 600 tokens. Overlap preserva contexto en los bordes.
CHUNK_SIZE=2400
CHUNK_OVERLAP=240

# --- Memoria de conversación ---
# Últimos N turnos (cada turno = pregunta + respuesta) por sesión.
MEMORY_LAST_TURNS=3

# --- Retención del historial (Ley 19.628: minimización / duración limitada) ---
# Edad máxima de los mensajes en la base (segundos) antes de borrarse
# automáticamente. 86400 = 24 horas. Los datos se mantienen anónimos.
HISTORY_MAX_AGE=86400

# =============================================
# =============================================
